<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="main">
  <BehaviorTree ID="main">
    <KeepRunningUntilFailure>
      <ParallelAll max_failures="-1">
        <Sequence>
          <IsButtonPressed button_index="{X_BUTTON}"
                           input_source="{joy_message}"/>
          <LogString message="X_BUTTON PRESS"/>
        </Sequence>
        <Sequence>
          <IsButtonPressed button_index="{SD_ESTOP}"
                           input_source="{stream_deck_message}"/>
          <LogString message="Hello World Stream!"/>
        </Sequence>
        <Sequence>
          <IsButtonJustPressed button_index="{Y_BUTTON}"
                               input_source="{joy_message}"/>
          <LogString message="Y_BUTTON JUST PRESS"/>
        </Sequence>
        <Sequence>
          <IsButtonPressed button_index="{LEFT_BUMPER}"
                           input_source="{joy_message}"/>
          <IsButtonPressed button_index="{RIGHT_BUMPER}"
                           input_source="{joy_message}"/>
          <LogString message="LEEFT_RIGHT BUMPER!"/>
        </Sequence>
        <Sequence>
          <IsButtonPressed button_index="{B_BUTTON}"
                           input_source="{joy_message}"/>
          <LogString message="Hello World!"/>
          <Sleep msec="1000"/>
        </Sequence>
        <AlwaysSuccess/>
      </ParallelAll>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="IsButtonJustPressed">
      <input_port name="button_index"/>
      <input_port name="input_source"
                  default="{joy_message}"/>
    </Condition>
    <Condition ID="IsButtonPressed">
      <input_port name="button_index"/>
      <input_port name="input_source"
                  default="{joy_message}"/>
    </Condition>
    <Action ID="LogString">
      <input_port name="message"/>
    </Action>
  </TreeNodesModel>

</root>
