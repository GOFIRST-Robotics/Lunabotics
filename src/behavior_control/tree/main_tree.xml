<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="MainTree">
    <Sequence>
      <Sequence name="Autonomus">
        <RetryUntilSuccessful num_attempts="5">
          <CalibrateFieldCoordinates/>
        </RetryUntilSuccessful>
        <KeepRunningUntilFailure>
          <Sequence>
            <GoToDigLocation/>
            <AutoDig digging_start_position="0.0"
                     digger_power="0.0"/>
            <SetPoseStamped x="0.0"
                            y="0.0"
                            yaw="0.0"
                            pose="{offload_pose}"/>
            <MoveTo goal="{offload_pose}"/>
            <AutoOffload dumping_position="0.0"
                         digger_power="0.0"/>
          </Sequence>
        </KeepRunningUntilFailure>
      </Sequence>
      <LogString message="Robot Failed!"/>
      <AlwaysFailure/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AutoDig"
            editable="true">
      <input_port name="digging_start_position"/>
      <input_port name="digger_power"/>
    </Action>
    <Action ID="AutoOffload"
            editable="true">
      <input_port name="dumping_position"/>
      <input_port name="digger_power"/>
    </Action>
    <Action ID="CalibrateFieldCoordinates"
            editable="true"/>
    <Action ID="GoToDigLocation"
            editable="true"/>
    <Action ID="LogString">
      <input_port name="message"/>
    </Action>
    <Action ID="MoveTo"
            editable="true">
      <input_port name="goal"/>
    </Action>
    <Action ID="SetPoseStamped"
            editable="true">
      <input_port name="x"/>
      <input_port name="y"/>
      <input_port name="yaw"/>
      <output_port name="pose"/>
    </Action>
  </TreeNodesModel>

</root>
